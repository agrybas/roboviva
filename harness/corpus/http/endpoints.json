        },
        "body": "{\"route\": {\"name\": \"Probe Route\", \"course_points\": [{\"t\": \"Right\", \"n\": \"Turn right onto Street 0\", \"d\": 400.0}], \"metrics\": {\"distance\": 1609.344, \"ele_gain\": 100.0}}}"
      },
      {
        "raise": "http",
        "status": 304
      }
    ]
  },
