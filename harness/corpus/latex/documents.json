    }
  },
  {
    "name": "unescaped_specials_survey",
    "why": "The other characters _escape does not handle: [ ] \" and a backtick. None are fatal, but '`' becomes a left quote and '\"' becomes a double quote, so the rendered text differs from what was typed.",
