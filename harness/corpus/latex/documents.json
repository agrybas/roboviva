  {
    "name": "caret_in_description",
    "why": "BUG: a bare '^' in a description is FATAL to the whole PDF. _escape (latex.py:48-63) covers # & $ _ | < > % { } and U+200B but NOT '^', which LaTeX reads as a superscript operator outside math mode -> 'Missing $ inserted' -> no output file at all. A rider who types '85^ cadence' or 'bear ^ the bridge' in RideWithGPS gets the 0xFF error page and no explanation. One cue poisons the entire sheet.",
    "route": {
      "entries": [
        {
          "instruction": "R",
          "description": "Point ^",
          "absolute_distance": 0.0,
          "note": "",
          "modifier": "",
          "for_distance": 1.0,
          "color": "None"
        }
      ],
      "length_mi": 1.0,
      "id": 15,
      "name": "Caret",
      "elevation_gain_ft": null
    }
  },
  {
    "name": "tilde_in_description",
    "why": "'~' is also unescaped, but it is a non-breaking space in LaTeX rather than a syntax error, so this one renders -- silently wrong instead of loudly broken.",
